# Copy to .env.local and fill in. Never commit the real values.
#
# Telegram bot that receives every form submission on the site: both
# /api/lead (the setup card and the callback form) and
# /api/cloud/onboarding. Server-side
# only: no NEXT_PUBLIC_ prefix, so these never reach the browser bundle.
# Create the bot with @BotFather to get the token; get the chat id by
# messaging the bot and reading getUpdates.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# The site's public host(s), used by both API routes to check that a
# submission came from our own page. Comma-separated. Behind Netlify the
# forwarded host is usually right on its own, so this is a safety net for
# the custom-domain-vs-*.netlify.app case. Host only, no scheme.
# SITE_HOST="velbiz.com"

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX.
# Deliberately NEXT_PUBLIC_: the tag runs in the browser and a measurement
# id is not a secret. Leave it unset and no analytics script is rendered
# at all, which is what local development should look like.
# The consent banner and lib/analytics.js gate every event on top of this.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
