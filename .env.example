# Copy to .env.local and fill in. Never commit the real values.
#
# Telegram bot that receives /cloud/onboarding submissions. Server-side
# only: no NEXT_PUBLIC_ prefix, so these never reach the browser bundle.
# Create the bot with @BotFather to get the token; get the chat id by
# messaging the bot and reading getUpdates.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# The site's public host(s), used by the onboarding route to check that a
# submission came from our own page. Comma-separated. Behind Netlify the
# forwarded host is usually right on its own, so this is a safety net for
# the custom-domain-vs-*.netlify.app case. Host only, no scheme.
# SITE_HOST="velbiz.in,velbiz.netlify.app"
